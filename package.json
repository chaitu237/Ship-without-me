{
  "name": "ship-without-me",
  "version": "0.3.0",
  "description": "Derivation-first agent skills for shipping launchable apps, plus a zero-dependency launch-readiness checker.",
  "type": "module",
  "bin": {
    "ship": "cli/detect.mjs",
    "ship-without-me": "cli/detect.mjs"
  },
  "files": [
    "cli/",
    "skills/",
    "schemas/",
    "scripts/plan.mjs",
    "commands/",
    "docs/",
    ".claude-plugin/",
    "AGENTS.md",
    "CONTEXT.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "detect": "node cli/detect.mjs",
    "test": "npm run lint:syntax && npm run check:skills && npm run check:registry && npm run test:detector && npm run test:routing && npm run check:adapters && npm run evals:validate",
    "lint:syntax": "node --check cli/detect.mjs && node cli/detect.mjs --help > /dev/null",
    "check:skills": "node scripts/check-skills.mjs",
    "check:adapters": "node scripts/sync-adapters.mjs --check",
    "test:detector": "node scripts/test-detector.mjs",
    "evals:validate": "node scripts/run-evals.mjs validate",
    "evals:plan": "node scripts/run-evals.mjs plan --trials 3",
    "sync": "node scripts/sync-adapters.mjs && node scripts/gen-rules-doc.mjs && node scripts/gen-registry.mjs",
    "check:registry": "node scripts/gen-registry.mjs --check",
    "test:routing": "node scripts/plan.mjs --test",
    "plan": "node scripts/plan.mjs",
    "evals:release": "node scripts/run-evals.mjs validate --release"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "launch-readiness",
    "linter",
    "ci",
    "skills"
  ],
  "license": "MIT",
  "author": {
    "name": "Chaitanya Dawkhar",
    "url": "https://github.com/chaitu237"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaitu237/Ship-without-me.git"
  },
  "homepage": "https://github.com/chaitu237/Ship-without-me#readme",
  "bugs": {
    "url": "https://github.com/chaitu237/Ship-without-me/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {}
}
