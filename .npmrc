# Routes the @chaitu237 scope to GitHub Packages.
#
# This file contains no credential and must never contain one. Authenticate in your
# HOME ~/.npmrc, never here — this file is committed:
#
#   npm login --scope=@chaitu237 --auth-type=legacy --registry=https://npm.pkg.github.com
#
@chaitu237:registry=https://npm.pkg.github.com
